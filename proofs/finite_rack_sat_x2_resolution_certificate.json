{
  "type": "unbounded_X2_q2_schema_coverage",
  "claim": "Every two-element finite bijective YBE solution is finite-rack dominated; the nine q=2 endpoint detector schemas cover all arities for the finite-rack SAT endpoint gate.",
  "scope": {
    "X_size": 2,
    "arities": "all n >= 2",
    "global_sawin_proof": false
  },
  "pair_encoding": "(x,y) -> 2*x + y",
  "solutions": [
    {"id": "X0", "table": [0, 1, 2, 3], "formula": "R(x,y)=(x,y)", "domination": "one_point_rack"},
    {"id": "X1", "table": [0, 2, 1, 3], "formula": "R(x,y)=(y,x)", "domination": "itself_trivial_two_point_rack"},
    {"id": "X2", "table": [1, 3, 0, 2], "formula": "R(x,y)=(y,t(x))", "domination": "conjugate_to_Q_flip_by_alternating_F_n"},
    {"id": "X3", "table": [2, 0, 3, 1], "formula": "R(x,y)=(t(y),x)", "domination": "itself_constant_action_rack"},
    {"id": "X4", "table": [3, 1, 2, 0], "formula": "R(x,y)=(t(y),t(x))", "domination": "two_point_trivial_rack_via_involutive_factorization"}
  ],
  "monoids": {
    "M1": {"size": 1, "identity": 0, "mul": [[0]], "gen": [0, 0]},
    "M2": {"size": 2, "identity": 0, "mul": [[0, 1], [1, 0]], "gen": [1, 1]},
    "M4": {
      "size": 4,
      "labels": ["e", "z", "a0", "a1"],
      "identity": 0,
      "mul": [[0, 1, 2, 3], [1, 1, 1, 1], [2, 1, 1, 1], [3, 1, 1, 1]],
      "gen": [2, 3]
    }
  },
  "racks": {
    "Q_id": {"table": [[0, 1], [0, 1]], "formula": "u ▷ v = v"},
    "Q_flip": {"table": [[1, 0], [1, 0]], "formula": "u ▷ v = 1-v"}
  },
  "detector_schemas": [
    {"id": "D0", "table": [0, 2, 1, 3], "rack": "Q_id", "monoid": "M1", "alpha": "x"},
    {"id": "D1", "table": [1, 3, 0, 2], "rack": "Q_id", "monoid": "M4", "alpha_one_on": [["e", 0, "a1"], ["e", 1, "a0"], ["a0", 0, "e"], ["a1", 1, "e"]]},
    {"id": "D2", "table": [1, 3, 0, 2], "rack": "Q_flip", "monoid": "M2", "alpha": "x+p mod 2"},
    {"id": "D3", "table": [1, 3, 0, 2], "rack": "Q_id", "monoid": "M4", "alpha_one_on": [["e", 0, "a0"], ["e", 1, "a1"], ["a0", 1, "e"], ["a1", 0, "e"]]},
    {"id": "D4", "table": [2, 0, 3, 1], "rack": "Q_id", "monoid": "M4", "same_alpha_as": "D1"},
    {"id": "D5", "table": [2, 0, 3, 1], "rack": "Q_flip", "monoid": "M1", "alpha": "x"},
    {"id": "D6", "table": [2, 0, 3, 1], "rack": "Q_id", "monoid": "M4", "same_alpha_as": "D3"},
    {"id": "D7", "table": [3, 1, 2, 0], "rack": "Q_id", "monoid": "M2", "alpha_one_on": [[0, 1, 1], [1, 0, 0]]},
    {"id": "D8", "table": [3, 1, 2, 0], "rack": "Q_id", "monoid": "M2", "alpha_one_on": [[0, 1, 0], [1, 0, 1]]}
  ],
  "coverage": [
    {"table": [0, 1, 2, 3], "coverage": "no principal bad pairs"},
    {"table": [0, 2, 1, 3], "coverage": "D0 for all n"},
    {"table": [1, 3, 0, 2], "coverage": "D2 for n>=3; D1/D2/D3 for n=2"},
    {"table": [2, 0, 3, 1], "coverage": "D5 for n>=3; D4/D5/D6 for n=2"},
    {"table": [3, 1, 2, 0], "coverage": "D7 for even n; D8 for odd n"}
  ],
  "bounded_counts": {
    "X2": {"2": 12, "3": 168, "4": 2880, "5": 59520, "unseparated": 0},
    "X4": {"2": 2, "3": 24, "4": 264, "5": 3120, "unseparated": 0}
  }
}
